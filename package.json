{
  "name": "dsh-session-suspend",
  "version": "0.2.5",
  "description": "会话挂起提醒：对话里自然语言挂起会话，侧边栏高亮并悬停显示提醒；折叠的工作区显示挂起数量；偏好接入 DSH 官方设置页，支持 /suspend /suspended /resume 斜杠命令。Park sessions with a natural-language note.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.6-alpha.1 <0.1.7 || >=0.1.7-alpha.1 <0.2.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session",
    "reminder",
    "suspend",
    "todo",
    "sidebar"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Archaofan/dsh-sidebar-reminder"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "gate": "node .sandbox/gate.cjs",
    "tools": "node .sandbox/tool-schema.cjs index.js",
    "client": "node .sandbox/client-harness.cjs client.js",
    "e2e": "node .sandbox/e2e/e2e.mjs",
    "e2e:new": "node .sandbox/e2e/e2e-new-surfaces.mjs",
    "e2e:features": "node .sandbox/e2e-new-features.mjs",
    "e2e:page": "node .sandbox/e2e-settings-page.mjs",
    "peers": "node .sandbox/verify-peer-claim.cjs .",
    "releases": "node .sandbox/verify-releases.cjs",
    "release-contents": "node .sandbox/verify-release-contents.cjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.1.6-alpha.1 <0.1.7 || >=0.1.7-alpha.1 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.6-alpha.1 <0.1.7 || >=0.1.7-alpha.1 <0.2.0-0"
  }
}
