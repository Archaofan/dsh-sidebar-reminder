{
  "name": "dsh-session-suspend",
  "version": "0.1.4",
  "description": "会话挂起提醒：对话里自然语言挂起会话，侧边栏高亮并悬停显示提醒；折叠的工作区显示挂起数量。Park sessions with a natural-language note.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.6-alpha.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session",
    "reminder",
    "suspend",
    "todo",
    "sidebar"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Archaofan/dsh-sidebar-reminder"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "gate": "node .sandbox/gate.cjs",
    "e2e": "node e2e/client.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.6-alpha.2"
  }
}
