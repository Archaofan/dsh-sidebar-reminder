# dependencies (needed for link installs; restore with: npm install)
node_modules/
.pnpm-store/

# this package is a plugin LIBRARY, not an app: ship the peerDependencies
# ranges, never a lockfile that pins DSH's own internals
pnpm-lock.yaml
package-lock.json

# sandbox test rig (see README "开发与沙箱验证")
.sandbox/
# the NEW sandbox, for 0.1.7. Ignored for the same reason AND because its home/
# holds live credentials and session state -- never commit a DSH_HOME.
.sandbox-next/

# A DSH_HOME is a directory of live credentials (.credentials.yaml,
# .anonymous-user-id, settings.yaml). Ignore the shapes one could take so a
# stray `git add -A` can never stage one, wherever it appears.
home/
.sandbox/home/
*.credentials.yaml
*.credentials.yml
.anonymous-user-id
settings.yaml
settings.yaml.imported

# development notes — internal research, not part of the published package
*调研*
*报告*
DEV-NOTES.md
research-*.md
_rm/
dsh-plugin-seams-report.md

# packed tarballs
*.tgz

# e2e screenshots (regenerate with E2E_SHOTS=<dir>)
e2e/shots/

# logs
*.log
npm-debug.log*
